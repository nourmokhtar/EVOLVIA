# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=evolvia

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# AWS S3 (optional - for image storage)
S3_BUCKET=evolvia-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Secret Key for JWT
SECRET_KEY=change-this-to-a-random-string-in-production

# Opik Observability & Tracing
OPIK_ENABLED=true
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT=evolvia-learn
OPIK_URL=

# Supabase Configuration (for video storage and optional cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET_NAME=vid

# Ollama Configuration (for personality analysis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_OLLAMA_FOR_PERSONALITY=true
